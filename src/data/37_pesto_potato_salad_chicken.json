  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Värm ugnen till 225 °C. Koka upp saltat vatten. Halvera tomaterna."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Mixa 10 tomathalvor med vitlök, 2 msk olja, vinäger, salt och peppar. Blanda kycklingen med marinaden och tillaga i ugnsform i 20–25 minuter."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Skala och tärna potatisen. Skär morötterna i stavar och koka i 10–15 minuter. Häll av och vänd ner sockerärtorna."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Mixa basilika, parmesan, resterande olja, salt och peppar till pesto. Blanda pesto med potatis, morötter, sockerärtor, lök och resterande tomater. Servera med kycklingen."
    }
  ]
