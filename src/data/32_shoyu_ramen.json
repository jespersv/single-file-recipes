  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Skär loss kycklingens bröst- och lårfiléer till annan användning. Lägg purjolök, kombu, bonitoflingor, fläskkött, kycklingskrov, ingefära, vitlök, morot och gul lök i en gryta. Salta och täck med vatten."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Sjud under lock på låg värme i 4–5 timmar, eller cirka 35 minuter i tryckkokare."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Sila buljongen genom durkslag och finmaskig sil. Plocka köttet från kycklingen och skiva fläskköttet."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Blanda soja, risvinäger och sesamolja. Smaka av buljongen med blandningen."
    },
    {
      "groupId": 1,
      "stepNumber": 5,
      "instruction": "Lägg nykokta nudlar och kött i skålar. Toppa med grönsaker och häll över het buljong. Strö över sesamfrön eller furikake."
    }
  ]
