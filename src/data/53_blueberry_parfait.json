  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Skölj limen och riv skalet. Pressa saften och blanda med skal, blåbär, 0,5 dl florsocker och mynta."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Vispa äggvitorna med resterande florsocker till ett hårt skum. Vispa grädden relativt hårt och blanda med mascarpone. Vänd ner blåbären och sedan äggvitorna."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Häll smeten i en 1,5-litersform, täck och frys cirka 6 timmar. Ta fram parfaiten cirka 30 minuter före servering."
