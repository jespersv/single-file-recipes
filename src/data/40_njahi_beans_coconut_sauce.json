  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Lägg bönorna i blöt i saltat vatten i cirka 8 timmar eller över natten. Skölj och koka i nytt vatten: koka kraftigt i 10 minuter och sjud sedan tills bönorna är mjuka, 1½–4 timmar. Spara minst 4,75 dl kokspad."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Hetta upp oljan i en gryta. Fräs lök och paprika i cirka 4 minuter. Tillsätt vitlök, salladslök, ingefära och spiskummin och fräs cirka 2 minuter."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Rör ner tomatpuré, garam masala, jalapeño, paprika, gurkmeja och salt. Fräs cirka 2 minuter."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Rör i kokosmjölken, bönorna och cirka 2,35 dl kokspad. Smaka av med salt och sjud utan lock i 30–60 minuter tills såsen är krämig. Rör ner koriander före servering."
    }
  ]
