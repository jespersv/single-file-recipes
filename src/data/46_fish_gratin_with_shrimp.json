  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Värm ugnen till 225 °C. Skär fisken i bitar och lägg i smord ugnsform. Salta och peppra och täck med bakplåtspapper. Baka cirka 15 minuter."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Häll fiskspadet i en kastrull. Tillsätt grädde, fond och mjöl under vispning. Koka upp och sjud 3 minuter. Tillsätt citron och dill och smaka av."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Skala räkorna och fördela över fisken. Spara några till garnering och häll såsen över fisken."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Skala och skär potatisen. Koka mjuk i lättsaltat vatten, cirka 20 minuter. Häll av och mosa. Blanda med het mjölk och smör, smaka av och rör ner äggulan."
    },
    {
      "groupId": 1,
      "stepNumber": 5,
      "instruction": "Spritsa eller klicka moset runt formen. Gratinera 10–15 minuter. Garnera med räkor, citron och dill."
    }
  ]
