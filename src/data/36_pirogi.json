  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Värm ugnen till 225 °C. Smält smöret, häll i mjölken och värm till 37 °C. Smula jästen i en bunke och lös upp den med lite av mjölkblandningen."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Blanda ner resten av mjölken, socker, salt och nästan allt mjöl. Arbeta degen smidig och låt jäsa under duk i 45 minuter."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Fräs hackad lök i smör tills den mjuknar. Bryn färsen och låt sjuda med pressad vitlök, tomater och soja. Smaka av med salt och peppar och koka bort vätskan."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Kavla ut degen, lägg på fyllning och ost, vik ihop och nyp kanterna. Pensla med uppvispat ägg och grädda tills gyllene."
    }
  ]
