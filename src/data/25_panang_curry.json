  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Häll en burk kokosmjölk i en kastrull och sjud tills mindre än hälften återstår och mjölken tjocknat, cirka 20 minuter. Rör då och då."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Hacka paprika och kyckling. Blanda currypastan med den reducerade kokosmjölken och fräs under omrörning."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Vänd ner kycklingen och stek tills den fått yta. Rör ner jordnötssmör och fräs kort."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Tillsätt den andra burken kokosmjölk, fisksås och limeblad. Sjud under lock i cirka 10 minuter."
    },
    {
      "groupId": 1,
      "stepNumber": 5,
      "instruction": "Tillsätt paprika och morot, smaka av med salt och sjud 10–15 minuter. Ta från värmen och rör ner thaibasilika. Servera med ris."
    }
  ]
}
