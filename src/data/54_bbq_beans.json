  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Värm ugnen till 150 °C. Tärna bacon och stek knaprigt. Ta upp och spara fettet."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Fräs finhackad lök i baconfettet tills mjuk och lätt brynt, cirka 7 minuter. Tillsätt hackad paprika, jalapeño och vitlök och fräs cirka 1 minut."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Rör ner ketchup, tomatpuré, socker, äppeljuice, honung, sirap, vinäger, BBQ-krydda, senap, stark sås, liquid smoke och bacon. Koka upp och vänd ner avrunna bönor."
    },
    {
      "groupId": 1,
      "stepNumber": 4,
      "instruction": "Tillaga i ugnen cirka 50 minuter. Låt vila 15 minuter och smaka av med salt och peppar."
    }
  ]
