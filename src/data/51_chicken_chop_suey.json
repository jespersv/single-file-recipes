  "instructions": [
    {
      "groupId": 1,
      "stepNumber": 1,
      "instruction": "Tärna kycklingen och blanda med risvinäger, lite salt och majsstärkelse. Blanda såsingredienserna i en skål. Hacka grönsakerna."
    },
    {
      "groupId": 1,
      "stepNumber": 2,
      "instruction": "Stek kycklingen gyllene i olja och lägg åt sidan. Stek lök och morot 1–2 minuter. Tillsätt övriga grönsaker och pressad vitlök och woka tills de mjuknat något."
    },
    {
      "groupId": 1,
      "stepNumber": 3,
      "instruction": "Tillsätt sås och kyckling och woka ihop. Smaka av med salt och servera med ris eller nudlar."
